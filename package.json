{
  "name": "soccer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "hash-password": "node scripts/hash-password.mjs",
    "lint": "oxlint",
    "test": "node --test \"test/**/*.test.ts\" \"test/**/*.test.js\"",
    "preview": "vite preview",
    "dev:api": "docker compose up -d --wait && node scripts/dev-api.ts",
    "typecheck": "tsc --noEmit",
    "build:api": "esbuild api/lambda.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-api/index.mjs --external:@aws-sdk/* --minify",
    "migrate": "node scripts/migrate-state.ts",
    "test:e2e": "playwright test",
    "validate:infra": "sam validate --lint --template-file template.yml --region us-east-1"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1150.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.1"
  }
}
